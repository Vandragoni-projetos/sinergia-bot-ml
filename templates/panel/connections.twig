{% extends 'panel/layout.twig' %}

{% set tz = 'America/Sao_Paulo' %}

{% block head %}
    {% if wa.refresh %}<meta http-equiv="refresh" content="{{ wa.refresh }};url=/conexoes#whatsapp">{% endif %}
{% endblock %}

{% block content %}
<ol class="flow" aria-label="Como o bot funciona">
    <li class="flow-current">Conectar</li>
    <li>O que vender</li>
    <li>Onde publicar</li>
    <li>O bot trabalha</li>
</ol>

<h1>{{ page.title }}</h1>
<p class="muted">{{ page.lead }}</p>

{% if ml.just_connected %}
    <p class="notice success" role="status">Mercado Livre conectado.</p>
{% endif %}

<div class="cards">
    <section class="card" aria-labelledby="ml-title">
        <header class="card-head">
            <h2 id="ml-title">Mercado Livre</h2>
            {% if ml.state == 'connected' %}
                <span class="pill ok">Conectado</span>
            {% elseif ml.state == 'connecting' %}
                <span class="pill wait">Conectando</span>
            {% elseif ml.state == 'error' %}
                <span class="pill bad">Erro</span>
            {% elseif ml.state == 'reconnect' %}
                <span class="pill bad">Reconexão necessária</span>
            {% else %}
                <span class="pill">Não conectado</span>
            {% endif %}
        </header>

        {% if ml.state == 'error' %}
            <p class="alert" role="alert">{{ ml.error }} Nada foi alterado{% if ml.still_connected %}; a conexão anterior continua ativa{% endif %}.</p>
        {% endif %}

        {% if ml.summary and (ml.state == 'connected' or ml.still_connected) %}
            <dl class="facts">
                <div><dt>Conta do Mercado Livre</dt><dd>nº {{ ml.summary.mlUserId ?? '—' }}</dd></div>
                <div><dt>Conectada em</dt><dd>{{ ml.summary.connectedAt|date('d/m/Y H:i', tz) }}</dd></div>
                <div><dt>Acesso válido até</dt><dd>{{ ml.summary.accessExpiresAt|date('d/m/Y H:i', tz) }}</dd></div>
                <div><dt>Renovação automática</dt><dd>{{ ml.summary.hasRefreshToken ? 'Ativa' : 'Indisponível — reconecte' }}</dd></div>
            </dl>
        {% elseif ml.state == 'reconnect' %}
            <p>A conexão desta conta não está mais válida. Conecte de novo para o bot voltar a consultar o Mercado Livre.</p>
        {% elseif ml.state == 'connecting' %}
            <p>Conexão iniciada. Conclua a autorização na página do Mercado Livre; o link vale 10 minutos.</p>
        {% elseif ml.state == 'disconnected' %}
            <p>Conecte a conta do Mercado Livre que o bot vai usar para encontrar os produtos. O login é feito no próprio Mercado Livre.</p>
        {% endif %}

        <form method="post" action="/conexoes/mercadolivre/conectar" class="actions">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            {% if ml.state == 'connected' %}
                <button type="submit">Reconectar</button>
            {% elseif ml.state == 'connecting' or ml.state == 'error' %}
                <button type="submit" class="primary-inline">Tentar de novo</button>
            {% else %}
                <button type="submit" class="primary-inline">Conectar Mercado Livre</button>
            {% endif %}
        </form>

        <section class="subcard" aria-labelledby="affiliate-title">
            <h3 id="affiliate-title">Afiliado</h3>
            <dl class="facts">
                <div><dt>Modo</dt><dd>{{ affiliate.mode == 'official_api' ? 'Integração oficial' : 'Gerador oficial em lote' }}</dd></div>
                <div><dt>Links de afiliado</dt><dd>Gerados por você no Gerador de Links do Mercado Livre e guardados por produto. <a href="/fila#afiliados">Preparar links na Fila</a></dd></div>
            </dl>

            {% if affiliate.feedback == 'declarado' %}
                <p class="notice success" role="status">Declaração registrada.</p>
            {% elseif affiliate.feedback == 'removido' %}
                <p class="notice" role="status">Declaração removida.</p>
            {% elseif affiliate.feedback == 'confirmacao_necessaria' %}
                <p class="alert" role="alert">Marque a confirmação para registrar a declaração.</p>
            {% endif %}

            {% if affiliate.declaration %}
                <p class="declared">
                    <strong>Mídias declaradas</strong> por {{ affiliate.declaration.user_name }}
                    em {{ affiliate.declaration.declared_at|date('d/m/Y H:i', tz) }}.
                </p>
                <p class="muted small">{{ affiliate.text }}</p>
                <form method="post" action="/conexoes/afiliado/declaracao" class="actions">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="acao" value="remover">
                    <button type="submit">Remover declaração</button>
                </form>
            {% else %}
                <form method="post" action="/conexoes/afiliado/declaracao">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="acao" value="declarar">
                    <label class="check">
                        <input type="checkbox" name="confirmo" value="1" required>
                        <span>{{ affiliate.text }}</span>
                    </label>
                    <div class="actions"><button type="submit">Registrar declaração</button></div>
                </form>
            {% endif %}
        </section>
    </section>

    {% set card = wa.card %}
    <section class="card" id="whatsapp" aria-labelledby="wa-title">
        <header class="card-head">
            <h2 id="wa-title">WhatsApp</h2>
            {% if card.state == 'connected' %}
                <span class="pill ok">Conectado</span>
            {% elseif card.state == 'waiting' %}
                <span class="pill wait">Aguardando conexão</span>
            {% elseif card.state == 'expired' %}
                <span class="pill bad">QR expirado</span>
            {% elseif card.state == 'disconnected' %}
                <span class="pill">Desconectado</span>
            {% elseif card.state == 'error' %}
                <span class="pill bad">Erro</span>
            {% elseif card.state == 'unavailable' %}
                <span class="pill">Indisponível</span>
            {% else %}
                <span class="pill">Não conectado</span>
            {% endif %}
        </header>

        {% if wa.feedback == 'desconectado' %}
            <p class="notice" role="status">WhatsApp desconectado.</p>
        {% elseif wa.feedback == 'aguarde' %}
            <p class="notice" role="status">Já existe uma operação em andamento. Aguarde alguns segundos.</p>
        {% endif %}
        {% if wa.error %}
            <p class="alert" role="alert">{{ wa.error }}{% if card.state != 'connected' %} Nada foi alterado.{% endif %}</p>
        {% endif %}

        {% if card.state == 'connected' %}
            <dl class="facts">
                <div><dt>Número</dt><dd>{{ card.phoneDisplay ?? '—' }}</dd></div>
                <div><dt>Perfil</dt><dd>{{ card.profileName ?? '—' }}</dd></div>
                {% if card.connectedAt %}<div><dt>Conectado em</dt><dd>{{ card.connectedAt|date('d/m/Y H:i', tz) }}</dd></div>{% endif %}
            </dl>
            <form method="post" action="/conexoes/whatsapp/desconectar" class="actions">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit">Desconectar</button>
            </form>
        {% elseif card.state == 'waiting' %}
            {% if card.qrCode %}
                <p>Abra o WhatsApp no celular › <strong>Aparelhos conectados</strong> › <strong>Conectar aparelho</strong> e leia o QR code.</p>
                <img class="qr" src="{{ card.qrCode }}" alt="QR code para conectar o WhatsApp" width="264" height="264">
            {% elseif card.pairCode %}
                <p>No WhatsApp do celular: <strong>Aparelhos conectados</strong> › <strong>Conectar com número de telefone</strong> e digite:</p>
                <p class="paircode">{{ card.pairCode }}</p>
            {% else %}
                <p>Gerando o código de conexão…</p>
            {% endif %}
            <p class="muted small">A página se atualiza sozinha. Este código vale por mais {{ card.secondsLeft }} segundos no máximo.</p>
            <form method="post" action="/conexoes/whatsapp/desconectar" class="actions">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit">Cancelar</button>
            </form>
        {% elseif card.state == 'unavailable' %}
            <p class="muted">A conexão do WhatsApp ainda não está disponível neste servidor.</p>
        {% else %}
            {% if card.state == 'expired' %}
                <p>O código de conexão expirou sem ser lido. Gere um novo para continuar.</p>
            {% elseif card.state == 'disconnected' %}
                <p>O WhatsApp desta conta está desconectado. Conecte de novo para o bot publicar.</p>
            {% else %}
                <p>Conecte o número de WhatsApp que vai publicar as ofertas.</p>
            {% endif %}
            <form method="post" action="/conexoes/whatsapp/conectar" class="actions">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="modo" value="qr">
                <button type="submit" class="primary-inline">{{ card.state == 'not_connected' ? 'Conectar com QR code' : 'Gerar novo QR code' }}</button>
            </form>
            <form method="post" action="/conexoes/whatsapp/conectar" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="modo" value="codigo">
                <label for="wa-phone">Ou receba um código de pareamento (número com DDI e DDD)</label>
                <div class="row">
                    <input id="wa-phone" name="telefone" inputmode="numeric" autocomplete="tel" placeholder="5511999999999" maxlength="20">
                    <button type="submit">Receber código</button>
                </div>
            </form>
        {% endif %}
    </section>
</div>
{% endblock %}
