{% extends 'base.twig' %}

{% block title %}Entrar · SINERGIA BOT ML{% endblock %}
{% block body_class %}auth{% endblock %}

{% block body %}
<main class="auth-card">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">S</span>
        <span class="brand-name">SINERGIA BOT ML</span>
    </div>
    <h1>Entrar no painel</h1>
    <p class="muted">Conecte, escolha o que vender, escolha onde publicar e deixe o bot trabalhar.</p>

    {% if error %}
        <p class="alert" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="/entrar" autocomplete="on">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" value="{{ email }}" required autocomplete="username" maxlength="190">
        <label for="password">Senha</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" maxlength="256">
        <button type="submit" class="primary">Entrar</button>
    </form>
</main>
{% endblock %}
