# SINERGIA BOT ML — exemplo de configuração.
# Copie para ".env" (que NUNCA é versionado) e preencha localmente.
# Todos os valores abaixo são fictícios.

# --- Aplicação ---
# production | staging | local | test
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=false
APP_VERSION=dev
# Chave mestra (32 bytes em base64) para cifrar tokens no banco.
# Gere com: php bin/console app:key:generate
APP_KEY=

# Instalação padrão usada pela CLI
INSTALLATION_SLUG=default

# --- Banco (MariaDB 11.4) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinergia
DB_USERNAME=sinergia
DB_PASSWORD=

# Banco exclusivo dos testes de integração (opcional; testes de banco são pulados se vazio)
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_DATABASE=sinergia_test
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# --- Mercado Livre (OAuth 2.0 oficial) ---
# Obtidos no DevCenter do Mercado Livre ao criar a aplicação.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser IDÊNTICA à cadastrada na aplicação (HTTPS, sem parâmetros variáveis).
ML_REDIRECT_URI=https://example.invalid/oauth/mercadolivre/callback
ML_SITE_ID=MLB
ML_PKCE_ENABLED=true
ML_HTTP_TIMEOUT_SECONDS=15
